---
// 首页（中英文共用）：一张图看懂、配好之后有什么、两种做法、完整路线（xxd-steps 竖排）、适不适合、卡住了找谁
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { STEPS, stepHref, link, langOf, t } from "../data/nav.js";
const lang = langOf(Astro.url.pathname);
const C = {
  zh: {
    title: "小小东 VPS 教程",
    h1: "出差到上网不方便的地方，也能正常用常用网站和 AI 工具",
    lead: "做法：自己租一台海外服务器，让 AI 按这套方案配好，手机和电脑导入订阅就能用。线路只给你和家人用，不和陌生人共享。跟着下面 8 步做，第一次大约一个小时。",
    start: "从第 0 步开始", faq: "先看常见问题",
    flowH: "一张图看懂", flowP: "整套东西只有三块：你的设备、你的服务器、你要访问的网站。",
    flow: [["Laptop", "你的设备", "电脑、手机、路由器装一个客户端，导入「订阅」。"], ["Server", "你的服务器", "在美国等地租的一台 VPS。AI 帮你装好节点、证书和自己的 AI 接口。"], ["Globe", "网站和 AI 工具", "ChatGPT、Claude、Gemini、谷歌等；看到的是服务器的 IP。"]],
    arrows: ["加密通道", "替你访问"],
    flowNote: "客户端里的「分流规则」决定哪些走服务器：国内网站直接访问、不绕路；国外网站和 AI 工具走你的服务器。",
    getH: "配好之后你有什么",
    get: [["一条自己的线路", "电脑、手机、路由器都能用。主、备两个节点，一个连不上自动换另一个。"], ["导入就能用", "常用网站和 AI 工具的分流规则已经配好，还防 DNS 泄露。"], ["自己的 AI 接口（CLIProxyAPI）", "把自己的 AI 账号变成一个接口，给各种 AI 工具用；会自动更新。"], ["基本不用管", "证书、规则、AI 接口自动更新，配置每天自动备份；服务器只能用你电脑上的密钥登录。"]],
    routesH: "两种做法，选一种", routesP: "区别只在第 3 步「配置服务器」由谁来敲命令。",
    routes: [["Bot", "让 AI 来配（推荐）", "有能在电脑上执行命令的 AI（比如 Claude Code、Codex）的人：复制一段话发给 AI，它会问你几个问题，然后自己配完、自己检查，大约 10 分钟。"], ["Terminal", "自己照着敲", "没有这类 AI 的人（只能聊天的 AI 不算）：网站会把每一步的命令列出来，复制、粘贴、回车，结果一样，只是慢一些。"]],
    stepsH: "完整路线", stepsP: "按顺序做。每一步结尾都有检查点，确认做对了再往下。", pending: "编写中", dot: " · ", stepsLabel: (n, first) => `完整路线：共 ${n} 步，从第 ${first} 步开始`,
    fitH: "适不适合你", fitYes: "适合", fitNo: "不适合",
    yes: ["经常出差或住在国外，需要稳定用 AI 工具", "想要一条只属于自己和家人的线路", "愿意花一个小时，跟着步骤做一遍"],
    no: ["想分享给朋友、对外出售：这套方案只给自己用", "希望去哪儿都一次连上、从不折腾：有的地方得换个网络或换个 IP", "完全不想自己动手：可以先收藏，找懂的人陪你做"],
  },
  en: {
    title: "XXD VPS Guide",
    h1: "Keep using your usual websites and AI tools, even where the internet is restricted",
    lead: "How: rent your own overseas server, let AI configure it with this setup, then import a subscription on your phone and computer. The line is just for you and your family — no strangers. Follow the 8 steps below; the first time takes about an hour.",
    start: "Start at step 0", faq: "Read the FAQ first",
    flowH: "The big picture", flowP: "There are only three parts: your devices, your server, and the sites you want to reach.",
    flow: [["Laptop", "Your devices", "Install an app on your computer, phone or router and import the \"subscription\"."], ["Server", "Your server", "A VPS you rent in the US or elsewhere. AI installs the nodes, certificate and your own AI API on it."], ["Globe", "Websites and AI tools", "ChatGPT, Claude, Gemini, Google… They see the server's IP."]],
    arrows: ["Encrypted tunnel", "Visits for you"],
    flowNote: "Routing rules in the app decide what goes through the server: Chinese sites go direct, with no detour; foreign sites and AI tools go through your server.",
    getH: "What you get",
    get: [["Your own line", "Works on computers, phones and routers. Main and backup nodes — if one fails, it switches automatically."], ["Ready on import", "Routing rules for common sites and AI tools are already set up, with DNS-leak protection."], ["Your own AI API (CLIProxyAPI)", "Turns your own AI accounts into one API for all kinds of AI tools; updates itself."], ["Practically maintenance-free", "Certificate, rules and AI API update automatically; config is backed up daily; the server only accepts your computer's key."]],
    routesH: "Two ways — pick one", routesP: "The only difference is who types the commands in step 3.",
    routes: [["Bot", "Let AI do it (recommended)", "If you have an AI that can run commands on your computer (such as Claude Code or Codex): paste one message to the AI; it asks a few questions, then configures and checks everything in about 10 minutes."], ["Terminal", "Type it yourself", "No such AI (chat-only AI doesn't count)? Every command is listed — copy, paste, Enter. Same result, just slower."]],
    stepsH: "The full route", stepsP: "Go in order. Each step ends with a checkpoint so you know it worked before moving on.", pending: "In progress", dot: " · ", stepsLabel: (n, first) => `The full route: ${n} steps, starting at step ${first}`,
    fitH: "Is it for you?", fitYes: "Good fit", fitNo: "Not a good fit",
    yes: ["You travel or live abroad and rely on AI tools", "You want a line that belongs only to you and your family", "You're willing to spend an hour following the steps"],
    no: ["You want to share it with friends or sell it — this is for personal use", "You expect it to work everywhere with zero fiddling — in some places you may need to switch networks or get a new IP", "You don't want to touch anything yourself — bookmark it and ask someone to help"],
  },
}[lang];
---
<Site title={C.title} wide>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={stepHref(STEPS[0], lang)}>{C.start}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" href={link("/faq/", lang)}>{C.faq}</a>
    </div>

    <section aria-labelledby="h-flow">
      <h2 id="h-flow">{C.flowH}</h2>
      <p>{C.flowP}</p>
      <div class="flow">
        {C.flow.map(([icon, title, desc], i) => (
          <>
            {i > 0 && <div class="flow__arrow" aria-hidden="true"><i data-xxd-icon="ArrowRight" data-size="16"></i>{C.arrows[i - 1]}</div>}
            <div class="flow__box" data-mine={i === 1 ? "" : undefined}>
              <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
              <p class="flow__title">{title}</p>
              <p class="flow__desc">{desc}</p>
            </div>
          </>
        ))}
      </div>
      <p class="flow__note">{C.flowNote}</p>
    </section>

    <section aria-labelledby="h-get">
      <h2 id="h-get">{C.getH}</h2>
      <ul class="xxd-list">
        {C.get.map(([a, b]) => <li class="xxd-list__item"><div class="xxd-list__main"><div class="xxd-list__title">{a}</div><div class="xxd-list__meta">{b}</div></div></li>)}
      </ul>
    </section>

    <section aria-labelledby="h-routes">
      <h2 id="h-routes">{C.routesH}</h2>
      <p>{C.routesP}</p>
      <div class="routes">
        {C.routes.map(([icon, h, p]) => <div class="route"><h3><i data-xxd-icon={icon} data-size="18"></i>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section aria-labelledby="h-steps">
      <h2 id="h-steps">{C.stepsH}</h2>
      <p>{C.stepsP}</p>
      <ol class="xxd-steps roadmap" data-vertical start={STEPS[0].n} aria-label={C.stepsLabel(STEPS.length, STEPS[0].n)}>
        {STEPS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              {s.ready
                ? <a class="xxd-steps__title xxd-steps__link" href={stepHref(s, lang)}>{t(s, "title", lang)}</a>
                : <span class="xxd-steps__title">{t(s, "title", lang)}<span class="xxd-badge roadmap__pending">{C.pending}</span></span>}
              <span class="xxd-steps__desc">{t(s, "minutes", lang)}{C.dot}{t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.fitYes}</h3><ul>{C.yes.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.fitNo}</h3><ul>{C.no.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <Contact />
  </div>
</Site>
