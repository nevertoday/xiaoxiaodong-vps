---
import Site from "../layouts/Site.astro";
import Q from "../components/Q.astro";
import Contact from "../components/Contact.astro";
import { FAQ } from "../data/faq.js";
import { FAQ_EN } from "../data/faq.en.js";
import { langOf } from "../data/nav.js";
import { inline } from "../lib/md.js";
const en = langOf(Astro.url.pathname) === "en";
const groups = en ? FAQ_EN : FAQ;
const headings = groups.map((g) => ({ slug: g.id, text: g.title, depth: 2 }));
const ISSUES = "https://github.com/nevertoday/xiaoxiaodong-vps/issues";
---
<Site title={en ? "FAQ" : "常见问题"} headings={headings}>
  <article class="xxd-prose">
    <h1>{en ? "FAQ" : "常见问题"}</h1>
    {en
      ? <p>Questions people have actually asked me, with my answers; more are added over time. Can't find yours? Open one on <a href={ISSUES}>GitHub</a>, or press <kbd class="xxd-kbd">⌘K</kbd> to search the whole site.</p>
      : <p>大家问过我的问题和我的回答，会陆续补充。没找到你的问题？到 <a href={ISSUES}>GitHub</a> 提一个，或者按 <kbd class="xxd-kbd">⌘K</kbd> 搜索全站。</p>}
    {groups.map((g) => (
      <>
        <h2 id={g.id}>{g.title}</h2>
        {g.items.map(([q, a], i) => <Q q={q} group={g.id} id={`${g.id}-${i + 1}`}><p set:html={inline(a)} /></Q>)}
      </>
    ))}
    <Contact />
  </article>
</Site>
